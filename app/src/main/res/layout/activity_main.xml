<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">
    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tên khoản chi"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtTenKhoanChi_316"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nhập tên khoản chi"
                android:inputType="text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Số tiền (VNĐ)"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtSoTien_316"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nhập số tiền"
                android:inputType="numberDecimal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Ghi chú"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtGhiChu_316"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nhập ghi chú"
                android:inputType="textMultiLine" />

            <Button
                android:id="@+id/btnThemKhoanChi316"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Thêm khoản chi" />

            <Button
                android:id="@+id/btnXemChiTiet_316"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Xem chi tiết khoản chi" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>